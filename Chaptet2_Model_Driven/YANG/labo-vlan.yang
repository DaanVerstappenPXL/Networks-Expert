module labo-vlan {
  yang-version 1.1;
  namespace "urn:pxl:labo:vlan";
  prefix lvlan;

  import ietf-inet-types { prefix inet; }

  organization "PXL Hogeschool - Networks Expert";
  description "Eenvoudig model voor VLAN-aanvragen.";

  revision 2026-10-17 {
    description "Eerste versie.";
  }

  container vlans {
    description "Alle aangevraagde VLANs.";

    list vlan {
      key "vlan-id";

      leaf vlan-id {
        type uint16 { range "1..4094"; }
      }

      leaf name {
        type string { length "1..32"; }
      }

      // TODO 1: leaf 'description' (string, optioneel)
      leaf description {
          type string;
      }
      // TODO 2: leaf 'enabled' (boolean, default true)
      leaf enabled {
          type boolean;
          default "true";
      }
      // TODO 3: container 'hosts' met leaf-list 'host-ip'
      //         van het type inet:ipv4-address
    }
  }
  container hosts {
    leaf-list host-ip {
      type "inet:ipv4-address";   
    }  
  }
}